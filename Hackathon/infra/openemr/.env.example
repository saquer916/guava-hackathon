# Copy to `.env` in this directory (ignored by git) and replace every value.
# Generate each password locally, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Never commit `.env`, never reuse a real credential, never paste values into logs.

OPENEMR_HTTPS_PORT=9300
OPENEMR_DB_ROOT_PASSWORD=
OPENEMR_DB_USER=openemr
OPENEMR_DB_PASSWORD=
OPENEMR_ADMIN_USER=synthetic-admin
OPENEMR_ADMIN_PASSWORD=
