# Guava reads GUAVA_API_KEY automatically. Prefer `guava login` for local auth.
GUAVA_API_KEY=
GUAVA_AGENT_NUMBER=

# Local synthetic OpenEMR FHIR endpoint and the existing synthetic patient.
OPENEMR_FHIR_BASE_URL=https://localhost:9300/apis/default/fhir
OPENEMR_BEARER_TOKEN=
OPENEMR_VERIFY_TLS=false
DEMO_PATIENT_ID=
DEMO_AUDIT_PATH=Hackathon/audit/stroke-emergency.jsonl
